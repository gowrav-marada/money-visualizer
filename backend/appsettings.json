{
  "ConnectionStrings": {
	"MoneyDatabase": "Data Source=App_Data/moneyvis.db"
  },
	"Database": {
	"MigrateOnStartup": true
	},
	"Authentication": {
	"Google": {
		"ClientId": "",
		"CallbackPath": "/signin-google"
	}
	},
	"Frontend": {
	"Origin": "http://localhost:4200"
	},
	"Email": {
	"RedirectBaseUrl": "http://localhost:4200",
	"Outlook": {
	  "ClientId": "",
	  "TenantId": "common"
	},
	"Gmail": {
	  "ClientId": ""
	},
	"MaxMessagesPerSync": 200,
	"LookbackDays": 60
  },
  "Attachments": {
	"Path": "App_Data/attachments",
	"MaxBytes": 5242880
  },
  "BackgroundJobs": {
	"Enabled": true,
	"IntervalMinutes": 60
  },
  "Logging": {
	"LogLevel": {
	  "Default": "Information",
	  "Microsoft.AspNetCore": "Warning",
	  "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
	}
  },
  "AllowedHosts": "*"
}
